  "SceneLines" : [
    {
      "Line" : {
        "zh" : "\u201C\u597D\uFF0C\u52C7\u6562\u7684\u5BB6\u4F19\u2026\u2026\u201D\u8001\u5DEB\u5A46\u671D\u4F60\u5FAE\u7B11\uFF0C\u773C\u795E\u7A7A\u6D1E\u3002",
        "en" : "\"Yes, brave one...\"\n\nThe hag smiles at you with her empty eyes.",
        "ja" : "\"Yes, brave one...\"\n\nThe hag smiles at you with her empty eyes."
      },
      "NextStep" : {
        "NextStep" : 0,
        "NextLine" : {
          "key" : "Main Hub",
          "type" : "DialogLine",
          "name" : {
            "zh" : "\u6211\u80FD\u4E3A\u4F60\u505A\u70B9\u4EC0\u4E48\uFF1F",
            "en" : "What can we do for you?",
            "ja" : "What can we do for you?"
          }
        }
      },
      "ShowContinueButton" : 0,
      "key"                : "HagIntro",
      "type"               : "dialog"
    },
    {
      "Line" : {
        "zh" : "\u6211\u80FD\u4E3A\u4F60\u505A\u70B9\u4EC0\u4E48\uFF1F",
        "en" : "What can we do for you?",
        "ja" : "What can we do for you?"
      },
      "ShowContinueButton" : 0,
      "PossibleAnswers"    : [
        {
          "Answer" : {
            "zh" : "\u6211\u5F97\u8D70\u4E86\u3002",
            "en" : "I have to go.",
            "ja" : "I have to go."
          },
          "NewNextLine" : {
            "NextStep" : 0,
            "NextLine" : {
              "key" : "Was good seeing you",
              "type" : "DialogLine",
              "name" : {
                "zh" : "\u5F88\u597D\u3002\n\n\u5F88\u9AD8\u5174\u89C1\u5230\u4F60\uFF0C\u52C7\u6562\u7684\u4EBA\u3002\n\u6211\u4EEC\u8FD8\u4F1A\u518D\u89C1\u7684\u2026\u2026",
                "en" : "Very well.\n\nIt was good seeing you, brave one.\n\nWe will meet again...",
                "ja" : "Very well.\n\nIt was good seeing you, brave one.\n\nWe will meet again..."
              }
            }
          }
        },
        {
          "Conditions" : {
            "PlayerUsesCard" : 0,
            "RequiredCardsNOTOnBoard" : [
              {
                "key" : "Bp_NightBroth",
                "type" : "CardData",
                "CardType" : 7,
                "icon"     : "CardData__Bp_NightBroth__CardImage",
                "name"     : {
                  "zh" : "\u6697\u591C\u6D53\u6C64",
                  "en" : "Night Broth",
                  "ja" : "Night Broth"
                }
              }
            ]
          },
          "Answer"     : {
            "zh" : "\u6211\u9700\u8981\u4F60\u7684\u77E5\u8BC6\u3002",
            "en" : "I need your knowledge.",
            "ja" : "I need your knowledge."
          },
          "NewNextLine" : {
            "NextStep" : 0,
            "NextLine" : {
              "key" : "Night Broth",
              "type" : "DialogLine",
              "name" : {
                "zh" : "\u5F88\u597D\u3002\u6211\u4EEC\u53EF\u4EE5\u6559\u4F60\u4E00\u4E24\u62DB\u3002\n\nd<b>\u6697\u591C\u6D53\u6C64\u5DF2\u4E60\u5F97</b>",
                "en" : "Very well. We can teach you a thing or two.\n\n<b>NIGHT BROTH LEARNED</b>",
                "ja" : "Very well. We can teach you a thing or two.\n\n<b>NIGHT BROTH LEARNED</b>"
              }
            }
          }
        },
        {
          "Answer" : {
            "zh" : "\u6211\u9700\u8981\u4F60\u7684\u5E2E\u52A9\u3002",
            "en" : "I need your help.",
            "ja" : "I need your help."
          },
          "NewNextLine" : {
            "NextStep" : 0,
            "NextLine" : {
              "key" : "Bargain Hub",
              "type" : "DialogLine",
              "name" : {
                "zh" : "\u662F\u7684\u2026\u2026\u6211\u4EEC\u770B\u5230\u4E86\u3002\n\n\u4F60\u8EAB\u8D1F\u91CD\u91CD\uFF0C\u8BA9\u6211\u4EEC\u66FF\u4F60\u5378\u4E0B\u4E00\u4E9B\u3002\n\n\u51E1\u4F60\u6240\u5F03\u4E4B\u7269\uFF0C\u6211\u4EEC\u7686\u53EF\u643A\u56DE\u5858\u4E2D\u3002",
                "en" : "Yes... we see it.\n\nYou're carrying so much. Let us lighten your load.\n\nWhatever you no longer want, we can carry back into our pond.",
                "ja" : "Yes... we see it.\n\nYou're carrying so much. Let us lighten your load.\n\nWhatever you no longer want, we can carry back into our pond."
              }
            }
          }
        }
      ],
      "key"                : "Main Hub",
      "type"               : "dialog"
    },
    {
      "Line" : {
        "zh" : "\u5F88\u597D\u3002\u6211\u4EEC\u53EF\u4EE5\u6559\u4F60\u4E00\u4E24\u62DB\u3002\n\nd<b>\u6697\u591C\u6D53\u6C64\u5DF2\u4E60\u5F97</b>",
        "en" : "Very well. We can teach you a thing or two.\n\n<b>NIGHT BROTH LEARNED</b>",
