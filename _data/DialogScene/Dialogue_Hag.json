    {
      "Line" : {
        "zh" : "\u662F\u7684\u2026\u2026\u6211\u4EEC\u770B\u5230\u4E86\u3002\n\n\u4F60\u8EAB\u8D1F\u91CD\u91CD\uFF0C\u8BA9\u6211\u4EEC\u66FF\u4F60\u5378\u4E0B\u4E00\u4E9B\u3002\n\n\u51E1\u4F60\u6240\u5F03\u4E4B\u7269\uFF0C\u6211\u4EEC\u7686\u53EF\u643A\u56DE\u5858\u4E2D\u3002",
        "en" : "Yes... we see it.\n\nYou're carrying so much. Let us lighten your load.\n\nWhatever you no longer want, we can carry back into our pond.",
        "ja" : "Yes... we see it.\n\nYou're carrying so much. Let us lighten your load.\n\nWhatever you no longer want, we can carry back into our pond."
      },
      "ShowContinueButton" : 0,
      "PossibleAnswers"    : [
        {
          "Answer" : {
            "zh" : "\u6211\u6539\u53D8\u4E3B\u610F\u4E86\u3002",
            "en" : "I changed my mind.",
            "ja" : "I changed my mind."
          },
          "NewNextLine" : {
            "NextStep" : 0,
            "NextLine" : {
              "key" : "HagIntro",
              "type" : "DialogLine",
              "name" : {
                "zh" : "\u201C\u597D\uFF0C\u52C7\u6562\u7684\u5BB6\u4F19\u2026\u2026\u201D\u8001\u5DEB\u5A46\u671D\u4F60\u5FAE\u7B11\uFF0C\u773C\u795E\u7A7A\u6D1E\u3002",
                "en" : "\"Yes, brave one...\"\n\nThe hag smiles at you with her empty eyes.",
                "ja" : "\"Yes, brave one...\"\n\nThe hag smiles at you with her empty eyes."
              }
            }
          }
        },
        {
          "Conditions" : {
            "PlayerUsesCard" : 0,
            "RequiredCardsNOTOnBoard" : [
              {
                "key" : "Spirit_HagBargainHunger",
                "type" : "CardData",
                "CardType" : 0,
                "icon"     : "GameStat__Appetite__FeedbackInfo-Icon",
                "name"     : {
                  "zh" : "\u9965\u9991\u5951\u7EA6",
                  "en" : "Hunger Bargain",
                  "ja" : "Hunger Bargain"
                }
              }
            ]
          },
          "Answer"     : {
            "zh" : "\u6211\u997F\u4E86\u3002",
            "en" : "I'm hungry.",
            "ja" : "I'm hungry."
          },
          "NewNextLine" : {
            "NextStep" : 0,
            "NextLine" : {
              "key" : "Hunger Bargain",
              "type" : "DialogLine",
              "name" : {
                "zh" : "\u5F88\u597D\u3002\n\n\u6211\u4EEC\u4FBF\u5C06\u6C5D\u4E4B\u9965\u997F\u643A\u8D70\uFF0C\u85CF\u4E8E\u6C34\u5E95\u3002\n\n\u5B83\u4E0D\u518D\u556E\u54AC\u4F60\u8EAB\uFF0C\u6C5D\u8179\u4EA6\u6C38\u4E0D\u590D\u54C0\u9E23\u3002\n\n\n\n<b>\u9965\u9991\u4E4B\u5951\u5DF2\u7ACB</b>\u201D",
                "en" : "Good. \n\nWe will take your hunger and keep it beneath the water then.\n\nIt will no longer gnaw at you. Your belly will never cry again.\n\n\n\n<b>HUNGER BARGAIN STRUCK</b>",
                "ja" : "Good. \n\nWe will take your hunger and keep it beneath the water then.\n\nIt will no longer gnaw at you. Your belly will never cry again.\n\n\n\n<b>HUNGER BARGAIN STRUCK</b>"
              }
            }
          }
        },
        {
          "Conditions" : {
            "PlayerUsesCard" : 0,
            "RequiredCardsNOTOnBoard" : [
              {
                "key" : "Spirit_HagBargainFear",
                "type" : "CardData",
                "CardType" : 0,
                "icon"     : "CardData__MeatHeartRaw__CardImage",
                "name"     : {
                  "zh" : "\u6050\u60E7\u5951\u7EA6",
                  "en" : "Fear Bargain",
                  "ja" : "Fear Bargain"
                }
              }
            ]
          },
          "Answer"     : {
            "zh" : "\u6211\u5F88\u5BB3\u6015\u3002",
            "en" : "I'm afraid.",
            "ja" : "I'm afraid."
          },
          "NewNextLine" : {
            "NextStep" : 0,
            "NextLine" : {
              "key" : "Fear Bargain",
              "type" : "DialogLine",
              "name" : {
                "zh" : "\u5F88\u597D\u3002\u6211\u4EEC\u4FBF\u5C06\u6C5D\u4E4B\u6050\u60E7\u643A\u8D70\uFF0C\u6EBA\u4E8E\u6C34\u5E95\u3002\n\n\u7FA4\u72FC\u89C6\u4E4B\u4E0D\u8FC7\u5982\u5154\uFF0C\u5CED\u58C1\u671B\u4E4B\u4EA6\u4E0D\u903E\u7F13\u4E18\u3002\n\n\n\n<b>\u6050\u60E7\u4E4B\u5951\u5DF2\u7ACB</b>",
                "en" : "Good. We will take your fear and drown it in the water then.\n\nThe wolves will seem no larger than rabbits. The cliffs no steeper than gentle hills.\n\n\n\n<b>FEAR BARGAIN STRUCK</b>",
                "ja" : "Good. We will take your fear and drown it in the water then.\n\nThe wolves will seem no larger than rabbits. The cliffs no steeper than gentle hills.\n\n\n\n<b>FEAR BARGAIN STRUCK</b>"
              }
            }
          }
        },
        {
          "Conditions" : {
            "PlayerUsesCard" : 0,
            "RequiredCardsNOTOnBoard" : [
              {
                "key" : "Spirit_HagBargainHealth",
                "type" : "CardData",
                "CardType" : 0,
                "icon"     : "GameStat__Fever__DefaultStatusIcon",
                "name"     : {
                  "zh" : "\u5EB7\u5065\u5951\u7EA6",
                  "en" : "Health Bargain",
                  "ja" : "Health Bargain"
                }
              }
            ]
          },
          "Answer"     : {
            "zh" : "\u6211\u75C5\u4E86\u3002",
            "en" : "I'm sick.",
            "ja" : "I'm sick."
          },
          "NewNextLine" : {
            "NextStep" : 0,
            "NextLine" : {
              "key" : "Health Bargain",
              "type" : "DialogLine",
              "name" : {
                "zh" : "\u5176\u4E0D\u613F\u968F\u6211\u7B49\u800C\u53BB\u3002\n\n\u5584\u54C9\u3002\u90A3\u6211\u4EEC\u4FBF\u4F7F\u5176\u6C38\u5C5E\u6C5D\u8EAB\u2014\u2014\u4E00\u5C0F\u7C07\u5FE0\u8150\uFF0C\u5E38\u4F34\u4E0D\u79BB\u3002\n\n\u5B83\u5C06\u508D\u6C5D\u5DE6\u53F3\uFF0C\u4EE4\u8BF8\u822C\u8D2A\u75BE\u65E0\u4EE5\u5BD3\u4E8E\u6C5D\u4F53\u3002\n\n\n\n<b>\u5EB7\u5065\u4E4B\u5951\u5DF2\u7ACB</b>",
                "en" : "It does not wish to leave with us.\n\nVery well. Then we shall make it yours forever. A small and faithful rot.\n\nIt will linger at your side and keep the hungrier sicknesses from finding a home within you.\n\n\n\n<b>HEALTH BARGAIN STRUCK</b>",
                "ja" : "It does not wish to leave with us.\n\nVery well. Then we shall make it yours forever. A small and faithful rot.\n\nIt will linger at your side and keep the hungrier sicknesses from finding a home within you.\n\n\n\n<b>HEALTH BARGAIN STRUCK</b>"
              }
            }
          }
        }
      ],
      "key"                : "Bargain Hub",
      "type"               : "dialog"
    },
