        "ja" : "\u3042\u306A\u305F\u306F\u3057\u3070\u3089\u304F\u77F3\u3078\u8A9E\u308A\u304B\u3051\u306A\u304C\u3089\u6642\u3092\u904E\u3054\u3059\u3002\n\n\u77F3\u304C\u8A00\u8449\u3092\u8FD4\u3059\u3053\u3068\u306F\u306A\u304B\u3063\u305F\u3002\n\u305D\u308C\u3067\u3082\u3001\u80F8\u306E\u5B64\u72EC\u306F\u5C11\u3057\u3060\u3051\u8EFD\u304F\u306A\u3063\u305F\u6C17\u304C\u3057\u305F\u3002"
