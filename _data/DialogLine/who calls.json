      "NewNextLine" : {
        "NextStep" : 0,
        "NextLine" : {
          "key" : "not much remains of you",
          "type" : "DialogLine",
          "name" : {
            "zh" : "\u73B0\u5728\u865A\u7A7A\u5DF2\u7ECF\u541E\u566C\u4E86\u4F60\uFF0C\u4F60\u51E0\u4E4E\u4EC0\u4E48\u90FD\u4E0D\u5269\u4E86\u3002\n\n\n\u4F46\u5728\u90A3\u541E\u566C\u4E2D\uFF0C\u4F60\u6446\u8131\u4E86\u4F60\u7684\u67B7\u9501\uFF0C\u4F60\u7684\u4E3B\u4EBA\u3002\n\n\n\u4E5F\u8BB8\uFF0C\u73B0\u5728\u4F60\u5DF2\u532E\u51C0\uFF0C\u80FD\u8BA9\u6211\u5BB9\u8EAB\u4E8E\u6B64\u3002",
            "en" : "Not much remains of you, now that the void has devoured you.\n\n\nBut in that devouring, you got rid of your chains, of your masters.\n\n\nPerhaps, now that you are empty and clean, there will be room for me.",
            "ja" : "\u865A\u7121\u306B\u55B0\u308F\u308C\u305F\u4ECA\u3001\u304A\u524D\u306B\u306F\u3082\u3046\u307B\u3068\u3093\u3069\u4F55\u3082\u6B8B\u3063\u3066\u3044\u306A\u3044\u3002\n\n\n\u3060\u304C\u3001\u305D\u306E\u6355\u98DF\u306B\u3088\u3063\u3066\u3001\u304A\u524D\u306F\u9396\u304B\u3089\u3001\u652F\u914D\u8005\u305F\u3061\u304B\u3089\u89E3\u304D\u653E\u305F\u308C\u305F\u3002\n\n\n\u7A7A\u3068\u306A\u308A\u6E05\u3081\u3089\u308C\u305F\u4ECA\u306A\u3089\u3001\u305D\u3053\u306B\u79C1\u306E\u5C45\u5834\u6240\u304C\u3042\u308B\u306E\u304B\u3082\u3057\u308C\u306A\u3044\u3002"
