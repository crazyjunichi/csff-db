  "ShowContinueButton" : 0,
  "PossibleAnswers"    : [
    {
      "Answer" : {
        "zh" : "\u6211\u662F\u4E2A\u61E6\u592B",
        "en" : "I am a coward",
        "ja" : "\u79C1\u306F\u81C6\u75C5\u8005\u3060"
      },
      "NewNextLine" : {
        "NextStep" : 0,
        "NextLine" : {
          "key" : "You are not alone",
          "type" : "DialogLine",
          "name" : {
            "zh" : "\u201C\u6CA1\u6709\u6050\u60E7\u662F\u4F60\u4E0D\u53EF\u6218\u80DC\u7684\u3002\u6211\u4EEC\u4F1A\u52A9\u4F60\u76F4\u9762\u5B83\u3002\u201D\n\n\u5979\u6D45\u7B11\uFF0C\u4EF0\u671B\u660E\u6708\u3002\n\u4F60\u611F\u5230\u6708\u5149\u6C81\u5165\u5FC3\u4E2D\u3002",
            "en" : "\" There is no fear you can't overcome. We will help you face it.\"\n\nShe smiles and looks up at the white moon above.\nYou feel the moonlight seep into your heart.",
            "ja" : "\u300C\u4E57\u308A\u8D8A\u3048\u3089\u308C\u306C\u6050\u308C\u306A\u3069\u306A\u3044\u3002\n\u79C1\u305F\u3061\u304C\u5171\u306B\u5411\u304D\u5408\u304A\u3046\u300D\n\n\u5F7C\u5973\u306F\u67D4\u3089\u304B\u304F\u5FAE\u7B11\u307F\u3001\u767D\u3044\u6708\u3092\u898B\u4E0A\u3052\u308B\u3002\n\u6708\u5149\u304C\u80F8\u306E\u5965\u3078\u9759\u304B\u306B\u67D3\u307F\u6E21\u3063\u3066\u3044\u304F\u3002"
          }
        }
      }
    },
    {
      "Answer" : {
        "zh" : "\u6211\u627E\u4E0D\u5230\u5B83\u4E86",
        "en" : "I cannot find it",
        "ja" : "\u898B\u3064\u3051\u3089\u308C\u306A\u3044\u30FB\u30FB\u30FB"
      },
      "NewNextLine" : {
        "NextStep" : 0,
        "NextLine" : {
          "key" : "We will guide you",
          "type" : "DialogLine",
          "name" : {
            "zh" : "\u201C\u6CA1\u6709\u91CE\u517D\u662F\u4F60\u4E0D\u53EF\u8FFD\u8E2A\u7684\u3002\u6211\u4EEC\u4F1A\u5E2E\u4F60\u627E\u5230\u5B83\u3002\u201D\n\n\u4F60\u6CE8\u610F\u5230\u91CE\u517D\u7684\u8E2A\u8FF9\uFF0C\u5728\u6708\u5149\u4E0B\u9690\u9690\u53D1\u4EAE\u3002\n\u91CE\u517D\u7684\u65B9\u4F4D\u5DF2\u4E86\u7136\u4E8E\u5FC3\u3002",
            "en" : "\" There is no beast you cannot track. We will help you find it.\"\n\nYou notice the beast's tracks, faintly glowing under the moonlight.\nYour heart knows how to find it.",
            "ja" : "\u300C\u8FFD\u3048\u306C\u7363\u306A\u3069\u5B58\u5728\u3057\u306A\u3044\u3002\n\u79C1\u305F\u3061\u304C\u305D\u306E\u9053\u3092\u793A\u305D\u3046\u300D\n\n\u7363\u306E\u8DB3\u8DE1\u304C\u6708\u5149\u306E\u4E0B\u3067\u6DE1\u304F\u8F1D\u3044\u3066\u3044\u308B\u3002\n\u3069\u3046\u8FFD\u3048\u3070\u3088\u3044\u306E\u304B\u3092\u3001\u5FC3\u306F\u3059\u3067\u306B\u77E5\u3063\u3066\u3044\u305F\u3002"
          }
        }
      }
    },
    {
      "Answer" : {
        "zh" : "\u6211\u8FD8\u4E0D\u591F\u5F3A\u58EE",
        "en" : "I am not strong enough",
        "ja" : "\u79C1\u306B\u306F\u30FB\u30FB\u30FB\u529B\u304C\u8DB3\u308A\u306A\u3044"
      },
      "NewNextLine" : {
        "NextStep" : 0,
        "NextLine" : {
          "key" : "No beast you cannot hunt",
          "type" : "DialogLine",
          "name" : {
            "zh" : "\u201C\u6CA1\u6709\u91CE\u517D\u662F\u4F60\u4E0D\u53EF\u730E\u5BFB\u7684\u3002\u6211\u4EEC\u4F1A\u540C\u4F60\u6D88\u706D\u5B83\u3002\u201D\n\n\u5979\u7684\u76EE\u5149\u63A0\u8FC7\u4F60\u7684\u6DEC\u6BD2\u730E\u77DB\u3002\n\u6B66\u5668\u4E0A\u6CDB\u8D77\u6708\u534E\u3002",
            "en" : "\"There is no beast you cannot hunt. We will help you slay it.\"\n\nHer eyes flick to your hunting spear, coated in poison.\nThe weapon glows with moonlight.",
            "ja" : "\u300C\u72E9\u308C\u306C\u7363\u306A\u3069\u3044\u306A\u3044\u3002\n\u79C1\u305F\u3061\u304C\u8A0E\u3064\u529B\u3092\u6388\u3051\u3088\u3046\u300D\n\n\u5F7C\u5973\u306E\u8996\u7DDA\u304C\u3001\u6BD2\u3092\u5857\u3089\u308C\u305F\u72E9\u731F\u69CD\u3078\u843D\u3061\u308B\u3002\n\u305D\u306E\u5203\u306F\u6708\u660E\u304B\u308A\u3092\u6D74\u3073\u3001\u9752\u767D\u304F\u8F1D\u3044\u3066\u3044\u305F\u3002"
          }
        }
      }
    }
  ],
