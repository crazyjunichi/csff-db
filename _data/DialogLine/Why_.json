    "ja" : "\u5F7C\u5973\u306F\u308F\u305A\u304B\u306B\u9996\u3092\u50BE\u3052\u308B\u3002\n\u300C\u30FB\u30FB\u30FB\u306A\u305C\uFF1F\u300D"
  },
  "OverrideSceneImage" : {
    "FileName" : "DialogLine__A_white_figure_emerges__OverrideSceneImage"
