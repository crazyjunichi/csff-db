
{
  "CardName" : {
    "zh" : "\u751F\u957F\u4E2D\u7684\u7075\u9B42\u83C7",
    "en" : "Growing Spirit Mushrooms",
    "ja" : "\u6210\u9577\u4E2D\u306E\u7CBE\u970A\u30AD\u30CE\u30B3"
  },
  "CardDescription" : {
    "zh" : "\u751F\u957F\u5728\u6A61\u6728\u6797\u9699\u4E2D\u3002\u9700\u8981\u9AD8\u9178\u5EA6\u3001\u6E7F\u5EA6\u548C\u517B\u5206\u3002\u79CB\u5929\u751F\u957F\u5F97\u66F4\u5FEB\u3002\n\n\u4E00\u79CD\u53EF\u98DF\u7528\u7684\u8611\u83C7\uFF0C\u80FD\u591F\u5F15\u8D77\u7CBE\u795E\u72B6\u6001\u7684\u6539\u53D8\u3002",
    "en" : "Found in oak clearings. Needs high acidity, hydration and nutrients. Grows faster during autumn.\n\nEdible mushrooms capable of inducing altered mind states.",
    "ja" : "\u30AA\u30FC\u30AF\u306E\u5E73\u5730\u3067\u898B\u3064\u3051\u3089\u308C\u308B\u3002\u9178\u5EA6\uFF08\u9AD8\uFF09\u3001\u6C34\u5206\uFF08\u9AD8\uFF09\u3001\u6804\u990A\uFF08\u9AD8\uFF09\u3067\u80B2\u3064\u3002\u79CB\u3060\u3068\u6210\u9577\u304C\u306F\u3084\u304F\u306A\u308B\u3002\n\n\u7CBE\u795E\u72B6\u614B\u3092\u5909\u3048\u308B\u98DF\u7528\u30AD\u30CE\u30B3\u3002"
  },
  "CardHelpSection" : {
    "zh" : "<b>\u4EA7\u5730\uFF1A</b>\u6A61\u6728\u6797\u9699\u3002\n\n<b>\u9700\u6C42\uFF1A</b>\u9AD8\u7B49\u9178\u5EA6\u3001\u6E7F\u5EA6\u3001\u517B\u5206\u3002\n\n<b>\u6548\u679C\uFF1A</b>\u6D3B\u8DC3\u7CBE\u795E\u3002",
    "en" : "<b>Found:</b> Oak clearings.\n\n<b>Growth Needs:</b> High Acidity, Hydration and Nutrients.\n\n<b>Benefits:</b> Psychoactive.",
    "ja" : "<b>\u767A\u898B\u5834\u6240\uFF1A</b> \u30AA\u30FC\u30AF\u306E\u5E73\u5730.\n\n<b>\u6210\u9577\u306B\u5FC5\u8981\uFF1A</b> \u9178\u5EA6\uFF08\u9AD8\uFF09\u3001\u6C34\u5206\uFF08\u9AD8\uFF09\u3001\u6804\u990A\uFF08\u9AD8\uFF09\u3002\n\n<b>\u30E1\u30EA\u30C3\u30C8\uFF1A</b> \u7CBE\u795E\u6D3B\u6027\u3002"
  },
