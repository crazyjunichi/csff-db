{"CardName":{"zh":"\u70E4\u7BB1","en":"Oven","ja":"\u30AA\u30FC\u30D6\u30F3"},"CardDescription":{"zh":"\u63A7\u5236\u6E29\u5EA6\u53EF\u4EE5\u5E72\u71E5\u3001\u70D8\u70E4\u6216\u70E7\u5236\u9676\u5668\u3002\n\n\u53EF\u4EE5\u7528\u706B\u79CD\u70B9\u71C3\uFF0C\u8BB0\u5F97\u8981\u63D0\u4F9B\u5145\u8DB3\u7684\u71C3\u6599\u3002","en":"Used for drying, baking, or firing pottery at controlled temperatures.\n\nCan be lit with tinder, provided it has enough fuel.","ja":"\u9676\u5668\u3092\u8ABF\u6574\u3057\u305F\u6E29\u5EA6\u3067\u713C\u3044\u305F\u308A\u4E7E\u304B\u3057\u305F\u308A\u3059\u308B\u305F\u3081\u306B\u4F7F\u3048\u308B\u3002\u30D9\u30FC\u30AD\u30F3\u30B0\u3082\u3067\u304D\u308B\u3002"},"CanBeRenamed":true,"AlternateNames":[{"Conditions":{"SpoilageRange":{"x":0.0,"y":1.0}},"Name":{"zh":"\u70E4\u7BB1\uFF08\u51B7\uFF09","en":"Oven (cold)","ja":"\u30AA\u30FC\u30D6\u30F3\uFF08\u51B7\u305F\u3044\uFF09"}},{"Conditions":{"SpoilageRange":{"x":2.0,"y":49.0}},"Name":{"zh":"\u70E4\u7BB1\uFF08\u964D\u6E29\u4E2D\uFF09","en":"Oven (cooling)","ja":"\u30AA\u30FC\u30D6\u30F3\uFF08\u51B7\u307E\u3057\u4E2D\uFF09"}},{"Conditions":{"SpoilageRange":{"x":50.0,"y":177.0}},"Name":{"zh":"\u70E4\u7BB1\uFF08\u5E72\u71E5\u4E2D\uFF09","en":"Oven (drying)","ja":"\u30AA\u30FC\u30D6\u30F3\uFF08\u4E7E\u71E5\u4E2D\uFF09"}},{"Conditions":{"SpoilageRange":{"x":178.0,"y":315.0}},"Name":{"zh":"\u70E4\u7BB1\uFF08\u70F9\u996A\u4E2D\uFF09","en":"Oven (cooking)","ja":"\u30AA\u30FC\u30D6\u30F3\uFF08\u30AF\u30C3\u30AD\u30F3\u30B0\u4E2D\uFF09"}},{"Conditions":{"SpoilageRange":{"x":316.0,"y":1000000.0}},"Name":{"zh":"\u70E4\u7BB1\uFF08\u70B9\u71C3\uFF09","en":"Oven (firing)","ja":"\u30AA\u30FC\u30D6\u30F3\uFF08\u713C\u3044\u3066\u3044\u308B\uFF09"}}],"CardHelpSection":{"zh":"\u70E4\u7BB1\u6839\u636E\u6E29\u5EA6\u4E0D\u540C\u6709\u4E09\u79CD\u5DE5\u4F5C\u6A21\u5F0F\uFF1A<b>\u5E72\u71E5\u3001\u70F9\u996A\u6216\u70E7\u5236</b>\u3002\n\u770B\u597D\u4F60\u7684\u71C3\u6599\uFF0C\u4FDD\u6301\u5728\u6240\u9700\u7684\u6E29\u5EA6\u8303\u56F4\u5185\u3002\n\n\n<b>\u5E72\u71E5\uFF1A</b>\u4FDD\u6301\u4F4E\u71C3\u6599\uFF08\u5C0F\u4E8E36\uFF09\u3002\u53EF\u4EE5\u5E72\u71E5\u7269\u54C1\u800C\u4E0D\u8FDB\u884C\u70F9\u996A\uFF0C\u5EF6\u957F\u5176\u4FDD\u8D28\u671F\u3002\n\n\n<b>\u70E7\u5236\uFF1A</b>\u4FDD\u6301\u9AD8\u71C3\u6599\u3002\u4F1A\u70E7\u7126\u5927\u90E8\u5206\u98DF\u7269\uFF0C\u4F46\u6E29\u5EA6\u9AD8\u4EE5\u70E7\u5236\u7C98\u571F\u3002","en":"The oven has 3 modes based on temperature: <b>Drying, Cooking or Firing</b>.\nManage your fuel to keep temperature at the desired range.\n\n\n<b>Drying:</b> Keep at low fuel (<36). Dries things without cooking them, extending their shelf life.\n\n<b>Firing:</b> Keep at high fuel. Will burn most edibles but be hot enough to fire clay.\n","ja":"\u30AA\u30FC\u30D6\u30F3\u306F\u6E29\u5EA6\u8ABF\u6574\u306B\u3088\u3063\u3066\u5909\u3048\u308B\u3053\u3068\u304C\u3067\u304D\u308B\uFF13\u3064\u306E\u6A5F\u80FD\u304C\u3042\u308B\uFF1A<b>\u4E7E\u71E5\u3001\u6599\u7406\u3001\u713C\u304D</b>\n\u71C3\u6599\u3092\u610F\u8B58\u3057\u3066\u6E29\u5EA6\u3092\u8ABF\u6574\u3057\u3088\u3046\u3002\n\n<b>\u4E7E\u71E5\uFF1A</b>\u71C3\u6599\u5C11\u306A\u3081<36). \u7269\u3092\u713C\u304B\u305A\u306B\u4E7E\u71E5\u3055\u305B\u308B\u3002\u9577\u6301\u3061\u3059\u308B\u3088\u3046\u306B\u306A\u308B\n\n<b>\u713C\u304D\uFF1A\u71C3\u6599\u591A\u3081\u3002\u307B\u3068\u3093\u3069\u306E\u98DF\u3079\u7269\u3092\u7126\u304C\u3057\u3066\u3057\u307E\u3046\u304C\u7C98\u571F\u3092\u713C\u304F\u3053\u3068\u304C\u3067\u304D\u308B\u3002"},"CardImage":{"FileName":"30502019b19874cb"},"CardType":2,"ObjectWeight":2500.0,"WeightReductionWhenEquipped":0.0,"TradingValue":0.0,"CardTags":[{"key":"tag_FuelCapacity","type":"CardTag","count":22,"name":{"zh":"\u71C3\u6599\u91CF","en":"Fuel Capacity","ja":"\u71C3\u6599\u306E\u30AD\u30E3\u30D1"}}],"MapStructureType":0,"FlavourFadeRate":0.0,"UsesOwnershipSystem":true,"AlwaysUpdate":true,"CannotBeTrashed":true,"CanBeTrashed":true,"ToggleablePiling":t