  "CardName" : {
    "zh" : "\u53EC\u5524\u6708\u4E4B\u5C11\u5973\u4E2D",
    "en" : "Moon Maiden Summoning",
    "ja" : "\u6708\u4E59\u5973\u306E\u53EC\u559A"
  },
  "CardDescription" : {
    "zh" : "\u6682\u65F6\u5C06\u6708\u5973\u7CBE\u9B44\u878D\u5165\u4F60\u7684\u7075\u9B42\uFF0C\u4F7F\u4F60\u4EEC\u878D\u4E3A\u4E00\u4F53\u3002",
    "en" : "Temporarily binds the moon maiden's spirit to your soul, making you both a bit more like the other.",
    "ja" : "\u6708\u89E6\u308C\u306E\u7CBE\u970A\u3092\u4E00\u6642\u7684\u306B\u9B42\u3078\u7D50\u3073\u4ED8\u3051\u308B\u3002\n\n\u4E92\u3044\u304C\u5C11\u3057\u305A\u3064\u3001\u76F8\u624B\u306B\u4F3C\u305F\u3082\u306E\u3078\u5909\u308F\u3063\u3066\u3044\u304F\u3002"
  },
  "CardHelpSection" : {
    "zh" : "\u590F\u4E4B\u82B1\uFF0C\u677E\u4E4B\u8840\uFF0C\u5931\u523B\u4E4B\u7269\u3002\n\u4E8E\u6EE1\u6708\u4E0B\u711A\u796D\u4E4B\uFF0C\u5524\u6211\u631A\u7231\u81F3\u8EAB\u8FB9\u3002",
    "en" : "Summer flowers, blood of pine, and a carving shaped by loss.\nBurn beneath the fullest moon, and call my love to me.",
    "ja" : "\u590F\u306E\u82B1\u3005\u3001\u677E\u306E\u8840\u3001\u305D\u3057\u3066\u55AA\u5931\u3092\u523B\u3093\u3060\u5F6B\u308A\u7269\u3002\n\u6E80\u3061\u304D\u3063\u305F\u6708\u306E\u4E0B\u3067\u305D\u308C\u3092\u71C3\u3084\u3057\u3001\u6211\u304C\u611B\u3092\u3053\u306E\u8EAB\u3078\u547C\u3073\u5BC4\u305B\u3088\u3002"
