  "CardDescription" : {
    "zh" : "\u51CF\u8F7B\u4F60\u7684\u53D1\u70ED\u3001\u75BC\u75DB\u3001\u538B\u529B\uFF0C\u964D\u4F4E\u6E05\u9192\u5EA6\uFF0C\u540C\u65F6\u7565\u5FAE\u8BA9\u4F60\u66F4\u5BB9\u6613\u9677\u5165\u7CBE\u795E\u5931\u5E38\u72B6\u6001\u3002",
    "en" : "Lowers fever, pain, stress and wakefulness, while slightly altering your mind state.",
    "ja" : "\u767A\u71B1\u3001\u75DB\u307F\u3001\u30B9\u30C8\u30EC\u30B9\u3001\u7720\u3055\u3092\u6539\u5584\u3057\u3001\u7CBE\u795E\u72B6\u614B\u3092\u5C11\u3057\u5909\u3048\u308B\u3002"
  },
  "CardHelpSection" : {
    "zh" : "<b>\u4EA7\u5730\uFF1A</b>\u6A61\u6728\u6797\u3002\n\n<b>\u9700\u6C42\uFF1A</b>\u4E2D\u7B49\u9178\u5EA6\uFF0C\u4E2D\u7B49\u6E7F\u5EA6\uFF0C\u4E2D\u3001\u9AD8\u7B49\u517B\u5206\u3002\n\n<b>\u6548\u679C\uFF1A</b>\u6B62\u75DB\u3001\u9000\u70E7\u3001\u9547\u9759\u3001\u6297\u7126\u8651\u3001\u7CBE\u795E\u4F5C\u7528\u3002",
    "en" : "<b>Found:</b> Oaken Groves.\n\n<b>Growth Needs:</b> Mid Acidity, Mid Hydration, Mid to High Nutrients.\n\n<b>Benefits:</b> Analgesic, Antipyretic, Sedative, Anxiolytic, Psychoactive.",
    "ja" : "<b>\u767A\u898B\u5834\u6240\uFF1A</b> \u30AA\u30FC\u30AF\u306E\u6797\u3002\n\n<b>\u6210\u9577\u306B\u5FC5\u8981\uFF1A</b> \u9178\u5EA6\uFF08\u4E2D\uFF09\u3001 \u6C34\u5206\uFF08\u4E2D\uFF09\u3001 \u6804\u990A\uFF08\u4E2D\uFF5E\u9AD8\uFF09\u3002\n\n<b>\u30E1\u30EA\u30C3\u30C8\uFF1A</b> \u89E3\u71B1\u5264\u3001 \u93AE\u9759\u5264\u3001 \u6297\u4E0D\u5B89\u5264\u3001 \u7CBE\u795E\u6D3B\u6027\u3002"
