  },
  "CardDescription" : {
    "zh" : "\u589E\u5F3A\u5E78\u798F\u5EA6\u3001\u514D\u75AB\u7CFB\u7EDF\u3001\u80FD\u91CF\u548C\u98DF\u6B32\uFF0C\u540C\u65F6\u51CF\u5C11\u6076\u5FC3\u548C\u8179\u6CFB\u3002",
    "en" : "Boosts wellbeing, immune system, energy and appetite while reducing nausea and diarrhoea.",
    "ja" : "\u5E78\u798F\u5EA6\u3001\u514D\u75AB\u529B\u3001\u30A8\u30CD\u30EB\u30AE\u30FC\u3001\u98DF\u6B32\u3092\u30D6\u30FC\u30B9\u30C8\u3057\u3001\u5410\u304D\u6C17\u3068\u4E0B\u75E2\u3092\u6539\u5584\u3059\u308B\u3002"
  },
  "CardHelpSection" : {
    "zh" : "<b>\u4EA7\u5730\uFF1A</b>\u6797\u9699\u3002\n\n<b>\u9700\u6C42\uFF1A</b>\u4E2D\u7B49\u9178\u5EA6\uFF0C\u4E2D\u7B49\u6E7F\u5EA6\uFF0C\u4E2D\u3001\u9AD8\u7B49\u517B\u5206\u3002\n\n<b>\u6548\u679C\uFF1A</b>\u589E\u5F3A\u514D\u75AB\u7CFB\u7EDF\u3001\u5174\u594B\u3001\u6B62\u5410\u3001\u4FC3\u8FDB\u98DF\u6B32\u3002",
    "en" : "<b>Found:</b> Clearings.\n\n<b>Growth Needs:</b> Mid Acidity, Mid Hydration, Mid to High Nutrients.\n\n<b>Benefits:</b> Immune System Booster, Stimulant, Antiemetic, Appetite Enhancer.",
    "ja" : "<b>\u767A\u898B\u5834\u6240\uFF1A</b> \u5E73\u5730\u3002\n\n<b>\u6210\u9577\u306B\u5FC5\u8981 \uFF1A</b> \u9178\u5EA6\uFF08\u4E2D\uFF09\u3001\u6C34\u5206\uFF08\u4E2D\uFF09\u3001\u6804\u990A\uFF08\u4E2D\uFF5E\u9AD8\uFF09\u3002\n\n<b>\u30E1\u30EA\u30C3\u30C8\uFF1A</b> \u514D\u75AB\u529B\u30A2\u30C3\u30D7\u3001\u523A\u6FC0\u7269\u3001\u5410\u304D\u6C17\u6B62\u3081\u3001\u98DF\u6B32\u30A2\u30C3\u30D7\u3002"
