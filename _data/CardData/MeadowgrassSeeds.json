
{
  "CardName" : {
    "zh" : "\u7267\u8349\u79CD\u5B50",
    "en" : "Meadowgrass Seeds",
    "ja" : "\u7267\u8349\u306E\u7A2E"
  },
  "CardDescription" : {
    "zh" : "\u826F\u597D\u7684\u8986\u571F\u4F5C\u7269\uFF0C\u80FD\u591F\u6539\u5584\u571F\u8D28\uFF0C\u9002\u5B9C\u7528\u4F5C\u571F\u58E4\u4F11\u8015\u3002",
    "en" : "A good cover crop deal for letting fields rest because of its soil structure improving capabilities.",
    "ja" : "\u571F\u58CC\u69CB\u9020\u306E\u6539\u826F\u52B9\u679C\u304C\u3042\u308B\u88AB\u8986\u4F5C\u7269\u3002"
  },
  "CardHelpSection" : {
    "zh" : "<b>\u4EA7\u5730\uFF1A</b>\u677E\u6728\u533A\u57DF\u3002\n\n<b>\u9700\u6C42\uFF1A</b>\u4E2D\u6216\u9AD8\u7B49\u9178\u5EA6\u3001\u4EFB\u610F\u6E7F\u5EA6\u3001\u4E2D\u6216\u9AD8\u7B49\u571F\u8D28\u3002\u6625\u3001\u590F\u5B63\u9AD8\u517B\u5206\u4E0B\u4EA7\u91CF\u6700\u9AD8\u3002\n\n<b>\u6548\u679C\uFF1A</b>\u57AB\u6599\uFF0C\u623F\u9876\u6750\u6599\uFF0C\u8986\u571F\u4F5C\u7269\u3002",
    "en" : "<b>Found:</b> Pine Clearings. \n\n<b>Growth Needs:</b> Mid or High Acidity, Any Hydration and Mid or High Structure. Produces the most yield on High Nutrients during Spring and Summer. \n\n<b>Benefits:</b> Bedding. Roofing. Cover Crop. ",
    "ja" : " <b>\u5165\u624B\uFF1A</b>\u677E\u306E\u7A7A\u304D\u5730\u3002\n\n<b>\u751F\u80B2\u6761\u4EF6\uFF1A</b>\u9178\u6027\u5EA6\uFF08\u4E2D\uFF5E\u9AD8\uFF09\u3001\u6C34\u5206\u91CF\uFF08\u4EFB\u610F\uFF09\u3001\u571F\u58CC\u69CB\u9020\uFF08\u4E2D\uFF5E\u9AD8\uFF09\u3002\u6625\u304B\u3089\u590F\u306B\u304B\u3051\u3066\u3001\u9AD8\u6804\u990A\u571F\u58CC\u3067\u6700\u3082\u53CE\u7A6B\u91CF\u304C\u5897\u3048\u308B\u3002\n\n<b>\u7528\u9014\uFF1A</b>\u5BDD\u5E8A\u6750\u3002\u5C4B\u6839\u6750\u3002\u88AB\u8986\u4F5C\u7269\u3002"
  },
